rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ===== USER PROFILE IMAGES =====
    // Users can only upload/update their own profile images
    match /profile-images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy profile image path (used by StorageUploader)
    match /profile_image/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // ===== POD CONTENT =====
    // Users can only upload content under their own user ID
    match /pod-content/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== THUMBNAILS =====
    // Thumbnails are public but only owners can upload
    match /thumbnails/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy thumbnail paths and general image uploads
    match /thumbnails/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // General image uploads (for thumbnails, etc.)
    match /images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // ===== USER DATA EXPORTS =====
    // Only the user can access their own data exports
    match /user-data-exports/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== ACCOUNT DATA EXPORTS =====
    // Only the user can access their own account data
    match /account-data/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== DENY BY DEFAULT =====
    // All other paths - deny access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
